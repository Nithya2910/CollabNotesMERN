# ── CollabNotes Backend Configuration Template ─────────────────────────────────
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit your '.env' file to version control.

# Server
PORT=8080
NODE_ENV=production

# MongoDB Connection (Replace with MongoDB Atlas connection string for production)
MONGO_URI=mongodb://localhost:27017/collab-notes

# JWT Authentication
# Generate a strong 64-char hex secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email Verification Service (SMTP / Gmail App Password)
# If using Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate an App Password (Google Account > Security > 2-Step Verification > App Passwords)
#   3. Paste the 16-character app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=CollabNotes <no-reply@collabnotes.com>
